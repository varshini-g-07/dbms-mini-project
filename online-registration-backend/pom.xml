<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. PARENT PROJECT: Uses the standard Spring Boot configuration -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version> <!-- Use a current, stable version -->
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- 2. PROJECT DETAILS -->
    <groupId>com.registration</groupId>
    <artifactId>course-registration-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>CourseRegistrationApi</name>
    <description>REST API for Student Course Registration</description>
    <properties>
        <java.version>17</java.version> <!-- Match your Java version -->
    </properties>

    <!-- 3. DEPENDENCIES (The critical section for adding libraries) -->
    <dependencies>
        <!-- Core Spring Boot for Web/REST APIs (Provides Tomcat, @RestController) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MySQL Connector (The JDBC Driver needed for your raw DAOs) -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version> <!-- Check for a compatible version -->
        </dependency>

        <!-- Standard Spring Boot Test Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- If you decide to use Spring Data JPA for easier data access, add this:
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        -->
        
    </dependencies>

    <!-- 4. BUILD PLUGINS -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>